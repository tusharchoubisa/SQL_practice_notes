show databases ;
use demodb;
show tables ;
drop table employees_self;
show tables;
CREATE TABLE staff (
 emp_id INTEGER PRIMARY KEY,
 emp_name TEXT,
 job_title TEXT,
 department TEXT,
 salary DECIMAL(10,2),
 hire_date DATE,
 manager_id INTEGER
);

