 # SQL Aggregate Functions — Question Set :
 
# Level 1 — Basic :- 
#Q1. Employees table mein total employees count karo
 select count(first_name) as total_employees from employees ;
#Q2. emp_id ko use karke total employees count karo.
select count(emp_id) as total_employees from employees;
#Q3. salary column mein kitni non-NULL values hain, count karo.
select count(salary) as salary_count from employees ;
#Q4. Sabhi employees ki total salary calculate karo.
select sum(salary) as total_salary from employees ;
#Q5. IT department ke employees ki total salary calculate karo.
select sum(salary) as IT_total from employees where department = 'IT';
#Q6. Company ki average salary find karo.
select avg(salary) as avg_salary from employees;
#Q7. HR department ki average salary find karo.
select avg(salary) as avg_salary from employees where department = 'hr';
#Q8. Company mein minimum salary find karo.
select min(salary) as min_salary from employees;
#Q9. IT department mein minimum salary find karo.
select min(salary) as min_salary from employees where department = 'it';
#Q10. Company mein maximum salary find karo.
select max(salary) as max_salary from employees;
#Q11. Sales department mein maximum salary find karo
select max(salary) as max_salary from employees where department = 'sales';

#Level 2 — GROUP BY : 
#Q12. Har department mein total employees count karo.
select department , count(department) from employees group by department;
#Q13. Har department ki total salary find karo.
select department , sum(salary) as total_salary  from employees group by department;
#Q14. Har department ki average salary find karo.
select department , avg(salary) as avg_salary  from employees group by department;
#15. Har department ki minimum salary find karo.
select department , min(salary) as min_salary  from employees group by department;
#Q16. Har department ki maximum salary find karo.
select department , max(salary) as max_salary  from employees group by department;
#Q17. Har department ke liye department, total_employees, total_salary, average_salary, minimum_salary aur
#maximum_salary ek saath display karo.
select department , count(first_name) as total_employes , sum(salary) as total_salary , avg(salary) as avg_salary, min(salary) as min_salary ,
max(salary) as max_salary from employees group by department ;

#Level 3 — Medium :

#Q18. Har department mein employees ki counting karo aur result ko total_employees naam do.
select department , count(first_name) as total_employees from employees group by department ;
#Q19. Department-wise average salary ko average_salary alias do
select department , avg(salary) as average_salary from employees group by department ;
#Q20. Department-wise total salary ko total_salary alias do.
select department , sum(salary) as total_salary from employees group by department ;
#Q21. Har department ki minimum aur maximum salary ek saath display karo.
select department , max(salary) as max_salary from employees group by department ;
#Q22. Har department mein kitne employees hain aur unki average salary kya hai?
select department , count(first_name) as total_employees , avg(salary) as avg_salary from employees group by department ;
#23. Har department ki total salary aur average salary dono display karo.
select department , sum(salary) as totak_salary , avg(salary) as avg_salary from employees group by department;
